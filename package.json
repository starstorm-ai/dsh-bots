{
  "name": "dsh-bots",
  "version": "0.1.0",
  "description": "LAN group chat and assistant sessions inside DeepSeek Harness",
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/types/packages/protocol/src/index.d.ts",
      "default": "./lib/protocol.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/protocol.js"
    },
    "./schema/command.json": "./packages/protocol/schema/command.schema.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/protocol.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "packages/protocol/schema/*.json",
    "packages/protocol/fixtures/*.json",
    "cordis.patch.yml",
    "compatibility.json",
    "README.md",
    "LICENSE",
    "docs/protocol.md",
    "docs/lan-api.md",
    "docs/ios.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "scripts": {
    "setup:dsh": "tsx scripts/setup-dsh.mts",
    "build": "tsx scripts/build.mts",
    "typecheck": "tsx scripts/build.mts --check",
    "test": "vitest run",
    "test:profile": "tsx scripts/smoke-profile.mts",
    "test:watch": "vitest",
    "pack:plugin": "tsx scripts/pack.mts",
    "dev:embedded-codex": "tsx scripts/embedded-codex.mts",
    "dev:install": "tsx scripts/embedded-codex.mts --install-only",
    "dev:remove": "tsx scripts/embedded-codex.mts --remove",
    "prepack": "tsx scripts/build.mts",
    "test:ui": "tsx scripts/smoke-ui.mts",
    "test:ios": "tsx scripts/test-ios.mts",
    "build:ios": "xcodebuild -project apps/ios/DSHBots.xcodeproj -scheme DSHBots -sdk iphoneos -destination generic/platform=iOS -derivedDataPath .tmp/ios-derived CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "@peculiar/x509": "^1.14.3",
    "ws": "^8.21.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "0.28.2",
    "lexical": "0.49.0",
    "playwright": "1.63.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
