{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh.local/bots/v1/command.schema.json",
  "title": "DSH Bots v1 command",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "command"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "enum": [
        "person.update",
        "person.revoke",
        "device.revoke",
        "scheduler.update",
        "bot.create",
        "bot.update",
        "bot.delete",
        "room.create",
        "room.update",
        "room.delete",
        "room.owner.transfer",
        "room.invite.create",
        "room.invite.revoke",
        "room.leave",
        "room.member.remove",
        "binding.create",
        "binding.remove",
        "binding.reset",
        "binding.grant.update",
        "message.send",
        "invocation.cancel",
        "invocation.retry",
        "interaction.answer",
        "sync.resume",
        "sync.ack",
        "read.update"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "person.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "displayName"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "person.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "personId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "personId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "device.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "deviceId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "scheduler.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "paused": {
                "type": "boolean"
              }
            },
            "required": [
              "paused"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "bot.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "avatar": {
                "enum": [
                  "charcoal",
                  "blue",
                  "teal",
                  "violet",
                  "amber",
                  "coral"
                ]
              },
              "instructions": {
                "type": "string",
                "maxLength": 16000
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "name",
              "sessionId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "bot.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "avatar": {
                "enum": [
                  "charcoal",
                  "blue",
                  "teal",
                  "violet",
                  "amber",
                  "coral"
                ]
              },
              "instructions": {
                "type": "string",
                "maxLength": 16000
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "botId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "bot.delete"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "botId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "direct",
                  "group"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "workspaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "acknowledgeSharedContext": {
                "type": "boolean"
              },
              "importHistory": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "title"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "pinned": {
                "type": "boolean"
              }
            },
            "required": [
              "roomId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.delete"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.owner.transfer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "personId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId",
              "personId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.invite.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.invite.revoke"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "inviteId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "inviteId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.leave"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "room.member.remove"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "personId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId",
              "personId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "binding.create"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "botId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "workspaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "sessionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "acknowledgeSharedContext": {
                "type": "boolean"
              },
              "importHistory": {
                "type": "boolean"
              }
            },
            "required": [
              "roomId",
              "botId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "binding.remove"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "bindingId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "binding.reset"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "workspaceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "bindingId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "binding.grant.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "bindingId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "personId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "canInvoke": {
                "type": "boolean"
              }
            },
            "required": [
              "bindingId",
              "personId",
              "canInvoke"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "message.send"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "clientMessageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "parts": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "text"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 32768
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "mention"
                        },
                        "botId": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        }
                      },
                      "required": [
                        "type",
                        "botId",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "replyToMessageId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "clientMessageId",
              "roomId",
              "parts"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "invocation.cancel"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "invocationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "invocationId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "invocation.retry"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "invocationId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "invocationId"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "interaction.answer"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "interactionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "revision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "answer": {}
            },
            "required": [
              "interactionId",
              "revision",
              "answer"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sync.resume"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "afterSeq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "storeEpoch": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "roomId",
              "afterSeq"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "sync.ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "roomId",
              "seq"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "read.update"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "roomId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "roomId",
              "seq"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
