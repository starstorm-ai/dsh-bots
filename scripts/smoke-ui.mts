/** Browser regression against test:profile --serve; never opens the user's profile. */
import assert from 'node:assert/strict'
import { readFileSync, writeFileSync } from 'node:fs'
import { resolve } from 'node:path'
import { DatabaseSync } from 'node:sqlite'
import { chromium } from 'playwright'
import type { Binding, Bot, ContextDelivery, Invocation, Message, Room } from '../packages/protocol/src/index.ts'
import { ROOT } from './lib/paths.mts'

const info = JSON.parse(readFileSync(resolve(ROOT, '.tmp/profile-smoke-latest.json'), 'utf8')) as { home: string; url: string; uiSessionId: string; roomId: string }
assert(resolve(info.home).startsWith(resolve(ROOT, '.tmp/profile-smoke-')), 'Only an isolated smoke profile is allowed')
assert(info.uiSessionId, 'Run pnpm test:profile --serve first')
const db = new DatabaseSync(resolve(info.home, 'data/dsh-bots/bots.sqlite'), { readOnly: true })
const records = <T,>(kind: string): T[] => (db.prepare('SELECT data FROM records WHERE kind=?').all(kind) as { data: string }[]).map(row => JSON.parse(row.data) as T)
const browser = await chromium.launch({ headless: true, ...(process.env.DSH_BOTS_BROWSER ? { executablePath: process.env.DSH_BOTS_BROWSER } : process.platform === 'win32' ? { channel: 'msedge' } : {}) })
const page = await browser.newPage({ viewport: { width: 1440, height: 980 }, locale: 'zh-CN' })
page.setDefaultTimeout(15_000)
const errors: string[] = []; const checks: string[] = []
page.on('pageerror', error => errors.push(error.message))
page.on('console', message => { if (message.type() === 'error') errors.push(message.text()) })
const mark = (name: string): void => { checks.push(name); console.log('PASS', name) }
const app = page.locator('.dsh-bots-app')
const screenshot = (name: string) => page.screenshot({ path: resolve(ROOT, `.tmp/ui-${name}.png`), fullPage: true, animations: 'disabled' })
const waitFor = async (condition: () => boolean | Promise<boolean>): Promise<void> => { const end = Date.now() + 15_000; while (!await condition()) { assert(Date.now() < end, 'Timed out waiting for synchronized state'); await page.waitForTimeout(100) } }
const name = `UI whale ${Date.now().toString().slice(-5)}`
try {
  await page.goto(info.url, { waitUntil: 'domcontentloaded' })
  const preview = page.getByRole('button', { name: '继续', exact: true })
  await page.getByRole('button', { name: 'Bots', exact: true }).waitFor()
  if (await preview.waitFor({ state: 'visible', timeout: 3000 }).then(() => true, () => false)) await preview.click()
  await page.getByText('Existing Session title check', { exact: true }).first().click()
  const nativeTab = page.getByRole('tab', { name: '对话', exact: true })
  await nativeTab.waitFor()
  const geometry = (element: Element) => { const s = getComputedStyle(element); return { height: element.getBoundingClientRect().height, fontSize: s.fontSize, lineHeight: s.lineHeight, padding: s.padding, borderRadius: s.borderRadius } }
  const nativeTabStyle = await nativeTab.evaluate(geometry)
  const nativeHeaderHeight = await nativeTab.evaluate(element => element.closest('header')!.getBoundingClientRect().height)
  await page.getByRole('tab', { name: '轨迹', exact: true }).click()
  const nativeToolbar = page.getByRole('toolbar', { name: '轨迹工具栏', exact: true })
  await nativeToolbar.waitFor()
  const nativeToolbarHeight = await nativeToolbar.evaluate(element => element.getBoundingClientRect().height)
  const nativeToolbarButton = await nativeToolbar.locator('button').first().evaluate(geometry)
  await screenshot('native-reference')
  await page.getByRole('button', { name: 'Bots', exact: true }).click()
  await app.locator('[role=tablist][aria-label="聊天"]').waitFor()
  if (await preview.isVisible()) await preview.click()
  assert.equal((await app.locator('[data-bots-header] nav').textContent())?.trim(), '')
  assert.equal(await app.locator('.bots-room-list').count(), 0)
  assert.deepEqual(await app.getByRole('tab', { name: '聊天', exact: true }).evaluate(geometry), nativeTabStyle)
  assert.equal(await app.locator('[data-bots-header]').evaluate(element => element.getBoundingClientRect().height), nativeHeaderHeight)
  assert.equal(await app.locator('.bots-switcher').evaluate(element => element.getBoundingClientRect().height), nativeToolbarHeight)
  assert.deepEqual(await app.locator('.bots-room-chip').first().evaluate(geometry), nativeToolbarButton)
  mark('native DSH tabs, header and trajectory toolbar geometry match exactly')
  mark('empty title and horizontal chat switcher')
  await screenshot('empty')
  await app.getByRole('tab', { name: '助理', exact: true }).click()
  await app.getByRole('button', { name: '创建助理', exact: true }).click()
  let dialog = page.getByRole('dialog')
  assert.equal(await dialog.locator('select').count(), 0)
  assert.equal(await dialog.getByRole('textbox').count(), 1)
  await dialog.getByLabel('名称', { exact: true }).fill(name)
  await dialog.getByRole('radio', { name: 'coral', exact: true }).click()
  const sessionPicker = dialog.getByRole('combobox', { name: '会话', exact: true })
  await sessionPicker.fill('现有会话标题验证')
  const candidate = dialog.getByRole('option').filter({ hasText: '现有会话标题验证' })
  await candidate.waitFor()
  assert.match(await candidate.innerText(), /fixture-workspace/)
  assert.equal(await dialog.locator('[data-trigger-menu]').count(), 1)
  await screenshot('session-picker')
  await sessionPicker.press('ArrowDown'); await sessionPicker.press('Enter')
  assert.equal(await sessionPicker.inputValue(), '现有会话标题验证')
  await dialog.getByRole('button', { name: '保存', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  await app.locator('.bots-bot-card').filter({ hasText: name }).waitFor()
  const bot = records<Bot>('bot').find(bot => bot.name === name)!
  assert.equal(bot.sessionId, info.uiSessionId)
  mark('native searchable Session menu binds an existing Session without LAN authorization')
  await screenshot('assistants')
  await app.getByRole('tab', { name: '聊天', exact: true }).click()
  await app.locator('.bots-new-chat').click()
  dialog = page.getByRole('dialog')
  await dialog.getByLabel('助理', { exact: true }).selectOption(bot.id)
  await dialog.getByLabel('聊天名称', { exact: true }).fill('UI direct conversation')
  await dialog.getByRole('button', { name: '创建', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  await app.locator('[data-bots-header] nav').filter({ hasText: 'UI direct conversation' }).waitFor()
  const binding = records<Binding>('binding').find(binding => binding.botId === bot.id && binding.active)!
  assert.equal(binding.sessionId, info.uiSessionId)
  const input = app.getByRole('textbox', { name: '输入消息…', exact: true })
  await input.waitFor()
  assert.equal(await input.getAttribute('contenteditable'), 'true')
  assert.equal(await app.locator('.bots-composer textarea').count(), 0)
  assert.equal(await app.locator('.bots-composer .bots-mention').count(), 1)
  await app.locator('.bots-composer .bots-mention').click()
  await input.fill('UI_CONTEXT_ONLY')
  await app.getByRole('button', { name: '发送', exact: true }).click()
  await waitFor(() => records<ContextDelivery>('context').some(context => context.bindingId === binding.id && context.status === 'accepted'))
  assert.equal(records<Invocation>('invocation').filter(task => task.bindingId === binding.id).length, 0)
  mark('native DSH editor sends context without invoking after mention removal')
  await app.locator('.bots-composer .bots-mention').click()
  await input.fill(`Please @${name.split(' ')[0]}`)
  await app.getByRole('listbox', { name: '选择助理', exact: true }).waitFor()
  await input.press('ArrowDown'); await input.press('Enter')
  assert.equal(await app.locator('.bots-composer .bots-mention').count(), 1)
  assert.equal(await input.innerText(), 'Please ')
  await input.fill('UI_TASK_WITH_MENTION')
  // A durable context receipt can precede the composer's final refresh/idle state.
  await waitFor(() => app.getByRole('button', { name: '发送', exact: true }).isEnabled())
  await input.press('Enter')
  await waitFor(() => records<Invocation>('invocation').some(task => task.bindingId === binding.id && task.status === 'completed'))
  await app.locator('.bots-message').filter({ hasText: 'Native continuation returned to the group.' }).waitFor()
  await app.locator('.bots-task-completed').waitFor()
  const human = records<Message>('message').filter(message => message.roomId === binding.roomId && message.text.includes('UI_TASK_WITH_MENTION'))
  assert.equal(human.length, 1)
  assert(!(await app.locator('.bots-timeline').innerText()).includes('[Task from'))
  assert.equal(await app.locator('[data-bots-turn]').count(), 1)
  const nativeTurn = app.locator('[data-bots-turn]')
  await nativeTurn.locator('[data-turn-process]').click()
  await nativeTurn.locator('[data-step-process]').waitFor({ state: 'visible' })
  await nativeTurn.locator('[data-step-process] > div > button').first().click()
  await nativeTurn.getByText('Checking the requested task.', { exact: true }).waitFor({ state: 'visible' })
  await nativeTurn.getByText('bots_ui_echo', { exact: true }).waitFor({ state: 'visible' })
  assert.equal(records<Message>('message').filter(message => message.bindingId === binding.id && message.source === 'tool').length, 1)
  await screenshot('process')
  await nativeTurn.locator('[data-turn-process]').click()
  await nativeTurn.getByText('Checking the requested task.', { exact: true }).waitFor({ state: 'hidden' })
  mark('keyboard @ selection invokes the chosen Session with one human echo and one final reply')
  await screenshot('chat')
  const contextMessage = records<Message>('message').find(message => message.roomId === binding.roomId && message.text === 'UI_CONTEXT_ONLY')!
  const contextBubble = app.locator(`[data-message-id="${contextMessage.id}"]`)
  await contextBubble.hover()
  await contextBubble.getByRole('button', { name: '回复', exact: true }).click()
  assert.match(await app.locator('.bots-reply-preview').innerText(), /UI_CONTEXT_ONLY/)
  await app.locator('.bots-composer .bots-mention').click()
  await input.fill('UI_REPLY_CONTEXT')
  await waitFor(() => app.getByRole('button', { name: '发送', exact: true }).isEnabled())
  await input.press('Enter')
  await waitFor(() => records<Message>('message').some(message => message.roomId === binding.roomId && message.text === 'UI_REPLY_CONTEXT'))
  const replyMessage = records<Message>('message').find(message => message.roomId === binding.roomId && message.text === 'UI_REPLY_CONTEXT')!
  assert.equal(replyMessage.replyToMessageId, contextMessage.id)
  const replyBubble = app.locator(`[data-message-id="${replyMessage.id}"]`)
  await replyBubble.locator('blockquote').waitFor()
  assert.match(await replyBubble.locator('blockquote').innerText(), /UI_CONTEXT_ONLY/)
  const searchToggle = app.locator('.bots-switcher').getByRole('button', { name: '搜索聊天历史', exact: true })
  await searchToggle.click()
  const historySearch = app.locator('.bots-history-search')
  await historySearch.getByRole('textbox').fill('UI_REPLY_CONTEXT')
  await historySearch.getByRole('button', { name: '搜索聊天历史', exact: true }).click()
  await historySearch.getByRole('button', { name: '返回聊天', exact: true }).waitFor()
  assert.equal(await app.locator('.bots-human-message').count(), 1)
  assert.match(await replyBubble.locator('blockquote').innerText(), /UI_CONTEXT_ONLY/)
  await historySearch.getByRole('button', { name: '返回聊天', exact: true }).click()
  await searchToggle.click()
  assert.equal(records<Invocation>('invocation').filter(task => task.bindingId === binding.id).length, 1)
  mark('quoted replies retain their context in the conversation and history search')
  await input.fill('Keep room draft')
  assert.equal(await input.locator('p').first().evaluate(element => getComputedStyle(element).margin), '0px')
  await input.press('Shift+Enter')
  await input.pressSequentially('Second line')
  assert.match(await input.innerText(), /Keep room draft\nSecond line/)
  await input.dispatchEvent('keydown', { key: 'Enter', code: 'Enter', isComposing: true, keyCode: 229, bubbles: true })
  assert.equal(records<Invocation>('invocation').filter(task => task.bindingId === binding.id).length, 1)
  await input.fill('Keep room draft')
  mark('Shift+Enter and IME Enter do not submit')
  await app.getByRole('tab', { name: 'Integration group', exact: true }).click()
  await app.locator('[data-bots-header] nav').filter({ hasText: 'Integration group' }).waitFor()
  assert.equal(await app.locator('.bots-composer .bots-mention').count(), 0)
  assert((await app.locator('.bots-stack-face').count()) >= 2)
  await app.locator('.bots-mention-trigger').click()
  await app.getByRole('listbox', { name: '选择助理', exact: true }).waitFor()
  await input.press('Escape')
  await page.getByRole('listbox', { name: '选择助理', exact: true }).waitFor({ state: 'hidden' })
  await app.getByRole('tab', { name: 'UI direct conversation', exact: true }).click()
  assert.equal(await input.innerText(), 'Keep room draft')
  mark('group avatars, mention launcher and independent room drafts')
  assert.equal(await app.getByRole('tab', { name: '连接', exact: true }).count(), 0)
  assert.equal(await app.locator('[data-bots-header] [role=tab]').count(), 2)
  assert.equal(records('workspace').length, 0); assert.equal(records('session-access').length, 0)
  mark('two native tabs and no workspace authorization settings or records')
  await app.locator('.bots-composer').getByRole('button', { name: '邀请成员', exact: true }).click()
  dialog = page.getByRole('dialog')
  await dialog.getByRole('img', { name: '聊天邀请二维码', exact: true }).waitFor()
  assert.match(await dialog.innerText(), /iOS/)
  const network = JSON.parse(readFileSync(resolve(info.home, 'data/dsh-bots/network.json'), 'utf8'))
  assert.equal(network.enabled, true); assert(network.port > 0)
  assert.equal(Object.keys(network).length, 2)
  type InviteRecord = { id: string; roomId: string; revokedAt?: string; token: string }
  const firstInvite = records<InviteRecord>('ticket').find(ticket => ticket.roomId === binding.roomId && !ticket.revokedAt)!
  assert(firstInvite); assert.equal(firstInvite.token, '')
  assert.equal(records<Room>('room').find(room => room.id === binding.roomId)?.kind, 'direct')
  await dialog.getByRole('button', { name: '刷新二维码', exact: true }).click()
  await waitFor(() => !!records<InviteRecord>('ticket').find(ticket => ticket.id === firstInvite.id)?.revokedAt)
  await dialog.getByRole('img', { name: '聊天邀请二维码', exact: true }).waitFor()
  await screenshot('invitation')
  await dialog.getByRole('button', { name: '撤销邀请', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  assert(records<InviteRecord>('ticket').filter(ticket => ticket.roomId === binding.roomId).every(ticket => ticket.revokedAt))
  assert.equal(await input.innerText(), 'Keep room draft')
  mark('composer invitation starts HTTPS automatically, refreshes and revokes the iOS QR without changing drafts')
  await page.reload({ waitUntil: 'domcontentloaded' })
  await page.getByRole('button', { name: 'Bots', exact: true }).click()
  await app.waitFor()
  await input.waitFor()
  assert.equal(await input.innerText(), 'Keep room draft')
  mark('selected chat and draft survive reconnect')
  await page.setViewportSize({ width: 740, height: 900 })
  await screenshot('narrow')
  const overflow = await app.evaluate(element => element.scrollWidth > element.clientWidth + 1)
  assert.equal(overflow, false)
  await page.emulateMedia({ colorScheme: 'dark' })
  await page.waitForFunction(() => document.body.hasAttribute('data-ds-dark-theme'))
  await screenshot('dark')
  const surface = await app.evaluate(element => ({ foreground: getComputedStyle(element).color, background: getComputedStyle(element).backgroundColor }))
  assert.notEqual(surface.background, 'rgb(255, 255, 255)')
  assert.notEqual(surface.foreground, surface.background)
  assert.equal(errors.length, 0, errors.join('\n'))
  mark('narrow layout and no browser exceptions')
  await page.setViewportSize({ width: 1440, height: 980 })
  await app.getByRole('tab', { name: '助理', exact: true }).click()
  const assistantCard = app.locator('.bots-bot-card').filter({ hasText: name })
  await assistantCard.getByRole('button', { name: '删除助理', exact: true }).click()
  dialog = page.getByRole('dialog')
  await dialog.getByRole('heading', { name: '删除助理', exact: true }).waitFor()
  assert.match(await dialog.innerText(), /聊天记录和原 DSH Session 会保留/)
  await screenshot('delete-assistant')
  await dialog.getByRole('button', { name: '取消', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  assert.equal(records<Binding>('binding').find(item => item.id === binding.id)?.active, true)
  const messagesBeforeDelete = records<Message>('message').filter(message => message.roomId === binding.roomId)
  await assistantCard.getByRole('button', { name: '删除助理', exact: true }).click()
  await dialog.getByRole('button', { name: '删除助理', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  await assistantCard.waitFor({ state: 'detached' })
  assert.equal(records<Binding>('binding').find(item => item.id === binding.id)?.active, false)
  assert.deepEqual(records<Message>('message').filter(message => message.roomId === binding.roomId), messagesBeforeDelete)
  await app.getByRole('tab', { name: '聊天', exact: true }).click()
  await app.locator('.bots-message').filter({ hasText: 'Native continuation returned to the group.' }).waitFor()
  assert.equal(await input.innerText(), 'Keep room draft')
  await app.locator('.bots-mention-trigger').click()
  const assistantMenu = app.getByRole('listbox', { name: '选择助理', exact: true })
  await assistantMenu.waitFor()
  assert.equal(await assistantMenu.getByRole('option').count(), 0)
  await input.press('Escape')
  await page.reload({ waitUntil: 'domcontentloaded' })
  await page.getByRole('button', { name: 'Bots', exact: true }).click()
  await app.getByRole('tab', { name: '助理', exact: true }).click()
  assert.equal(await assistantCard.count(), 0)
  await app.getByRole('button', { name: '创建助理', exact: true }).click()
  dialog = page.getByRole('dialog')
  await dialog.getByLabel('名称', { exact: true }).fill(`${name} replacement`)
  const freedSession = dialog.getByRole('combobox', { name: '会话', exact: true })
  await freedSession.fill('现有会话标题验证')
  await dialog.getByRole('option').filter({ hasText: '现有会话标题验证' }).waitFor()
  await freedSession.press('ArrowDown'); await freedSession.press('Enter')
  await dialog.getByRole('button', { name: '保存', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  const replacementCard = app.locator('.bots-bot-card').filter({ hasText: `${name} replacement` })
  await replacementCard.waitFor()
  assert.equal(records<Bot>('bot').find(item => item.name === `${name} replacement`)?.sessionId, info.uiSessionId)
  await replacementCard.getByRole('button', { name: '删除助理', exact: true }).click()
  await dialog.getByRole('button', { name: '删除助理', exact: true }).click()
  await dialog.waitFor({ state: 'hidden' })
  await replacementCard.waitFor({ state: 'detached' })
  assert.equal(errors.length, 0, errors.join('\n'))
  mark('assistant deletion confirms, preserves chat history and drafts, survives reload and releases its existing Session')
  writeFileSync(resolve(ROOT, '.tmp/ui-smoke-results.json'), JSON.stringify({ checks, errors, rooms: records<Room>('room').length }, null, 2))
} catch (error) {
  await screenshot('failure')
  writeFileSync(resolve(ROOT, '.tmp/ui-smoke-results.json'), JSON.stringify({ checks, errors, failure: String(error).replace(/token=[^&\s"']+/g, 'token=REDACTED') }, null, 2))
  throw error
} finally { db.close(); await browser.close() }
